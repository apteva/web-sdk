{
  "name": "@apteva/web-sdk",
  "version": "0.9.0",
  "description": "Browser SDK for apteva-server. Handles session cookies, API keys, and opaque application-user access tokens; wraps app HTTP, MCP, agents, chat, telemetry, and authenticated SSE. Framework-agnostic.",
  "license": "MIT",
  "author": "Apteva",
  "homepage": "https://github.com/apteva/web-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apteva/web-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/apteva/web-sdk/issues"
  },
  "keywords": [
    "apteva",
    "sdk",
    "mcp",
    "agents",
    "auth",
    "browser"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:mixed-apps": "bun scripts/test-mixed-apps.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.4.0"
  }
}
